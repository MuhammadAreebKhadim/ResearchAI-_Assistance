# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Research APIs (All free - no key required for basic use)
# Semantic Scholar - optional key for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex - add your email for the "polite pool" (higher rate limits)
OPENALEX_EMAIL=your@email.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/research_assistant

# App
SECRET_KEY=your_very_secret_key_here_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
